# ============================================================
# 借款业务管理系统 — 环境变量配置
# 复制本文件为 .env 并填入实际值
# ============================================================

# ── 数据库（Supabase PostgreSQL） ──
# 连接池地址（应用运行时）：Supabase 控制台 → Project Settings → Database → Connection Pooling
# 格式：postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# 直连地址（Prisma migrate/seed）：Supabase 控制台 → Project Settings → Database → Connection string
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Supabase API ──
# Supabase 控制台 → Project Settings → API
# Project URL
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# anon (public) key — 前端可用
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGci..."
# service_role key — 仅服务端使用，绝对不要暴露到前端
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."
# 私有证件/资金凭证 bucket（执行 npm run storage:ensure 创建或校正）
SUPABASE_STORAGE_BUCKET="internal-files"

# ── 认证 ──
# JWT 签名密钥（必填、不能使用默认值。生成：openssl rand -base64 32）
JWT_SECRET="change-me-in-production"

# ── 首次管理员引导（仅在没有可用超级管理员时供 npm run db:seed 使用）──
# 首次种子执行前临时设置；成功后立即从本地、CI 和托管平台环境中删除密码变量。
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_REAL_NAME="系统管理员"

# ── 变更型回归测试隔离（生产环境禁止配置）──
# test:regression、test:launch-readiness、test:external-touchpoints 和
# test:message-delivery-queue 会写入测试数据，必须使用独立数据库。
REGRESSION_DATABASE_URL=""
# 仅在确认上面的连接是隔离测试库时，临时设置为：
# I_UNDERSTAND_THIS_WRITES_TEST_DATA
ALLOW_REGRESSION_FIXTURES=""

# ── Cron 鉴权（必填）──
# 三个 cron 路由（overdue / notifications / message-deliveries/retry）会校验
#   Authorization: Bearer ${CRON_SECRET}
# 未设置时所有 cron 接口直接返回 503（fail-closed）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET="change-me"

# ── CORS ──
# 允许跨域请求的前端域名（逗号分隔）
# 开发环境下 localhost 会自动放行，无需额外配置
ALLOWED_ORIGINS="https://your-production-domain.com"
